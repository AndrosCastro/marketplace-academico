# Copia este archivo como .env y ajusta los valores.
# Base de datos local (docker compose up -d db). En Vercel/Neon se configuran automáticamente.
DATABASE_URL="postgresql://marketplace:marketplace_local_dev@localhost:5433/marketplace"
DATABASE_URL_UNPOOLED="postgresql://marketplace:marketplace_local_dev@localhost:5433/marketplace"

# Secreto para firmar/derivar tokens de sesión. Mínimo 32 caracteres.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="dev-only-secret-cambialo-en-produccion-0123456789abcdef"

# Dominios de correo permitidos para registrarse, separados por coma (vacío = cualquiera).
# Ejemplo para limitar a la comunidad UTH:  ALLOWED_EMAIL_DOMAINS="uth.hn,uth.edu.hn"
ALLOWED_EMAIL_DOMAINS=""

# Datos de prueba (solo los usa `npm run db:seed`).
# La cuenta administradora se crea con este correo y contraseña. Cámbiala SIEMPRE en producción.
SEED_ADMIN_EMAIL="admin@marketplace.test"
SEED_ADMIN_PASSWORD="Admin#Demo2026!"
# Contraseña para las cuentas de estudiantes de demostración (ana@marketplace.test, etc.).
SEED_DEMO_PASSWORD="Demo#Estudiante2026"
