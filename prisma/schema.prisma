// =====================================================================
// Marketplace Académico de Servicios Estudiantiles - Modelo de datos
// Basado en el diccionario de datos y la SRS v2.0 (Avance II).
// Motor: PostgreSQL (local con Docker, producción con Neon en Vercel).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Rol {
  ESTUDIANTE
  ADMIN
}

enum EstadoServicio {
  ACTIVO
  RETIRADO
}

enum UnidadPrecio {
  HORA
  SERVICIO
}

// Siete estados definidos en la sección 3.3 de la SRS.
enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  PAGO_CONFIRMADO
  ENTREGADA
  COMPLETADA
  RECHAZADA
  CANCELADA
}

enum Modalidad {
  PRESENCIAL
  VIDEOCONFERENCIA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoReporte {
  ABIERTO
  RESUELTO
  DESCARTADO
}

// ---------------------------------------------------------------------
// USUARIOS (RF-01 a RF-03, RF-14)
// ---------------------------------------------------------------------
model Usuario {
  id              String    @id @default(cuid()) @map("id_usuario")
  nombre          String    @db.VarChar(100)
  correo          String    @unique @db.VarChar(150)
  contrasenia     String    @db.VarChar(255) // hash bcrypt, nunca texto plano
  carrera         String?   @db.VarChar(100)
  contacto        String?   @db.VarChar(30) // WhatsApp/teléfono: solo visible con pago confirmado
  descripcion     String?   @db.Text
  habilidades     String?   @db.VarChar(255)
  rol             Rol       @default(ESTUDIANTE)
  activo          Boolean   @default(true) // false = suspendido por un administrador
  reputacion      Decimal?  @db.Decimal(3, 2) // promedio (RF-14); null = "Sin calificaciones"
  totalResenas    Int       @default(0) @map("total_resenas")
  fechaRegistro   DateTime  @default(now()) @map("fecha_registro")

  servicios       Servicio[]
  solicitudes     Solicitud[] @relation("ClienteSolicitudes")
  mensajes        Mensaje[]
  sesiones        Sesion[]
  reportes        Reporte[]   @relation("ReportesCreados")
  bitacora        Bitacora[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------
// CATEGORÍAS
// ---------------------------------------------------------------------
model Categoria {
  id          Int        @id @default(autoincrement()) @map("id_categoria")
  nombre      String     @unique @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  icono       String     @default("✨") @db.VarChar(8)
  servicios   Servicio[]

  @@map("categorias")
}

// ---------------------------------------------------------------------
// SERVICIOS (RF-04 a RF-08)
// ---------------------------------------------------------------------
model Servicio {
  id                String         @id @default(cuid()) @map("id_servicio")
  proveedorId       String         @map("id_proveedor")
  categoriaId       Int            @map("id_categoria")
  titulo            String         @db.VarChar(100)
  descripcion       String         @db.Text
  precio            Decimal        @db.Decimal(10, 2)
  unidadPrecio      UnidadPrecio   @default(HORA) @map("unidad_precio")
  modalidad         Modalidad?
  horario           String?        @db.VarChar(150)
  estado            EstadoServicio @default(ACTIVO)
  fechaPublicacion  DateTime       @default(now()) @map("fecha_publicacion")
  fechaModificacion DateTime?      @updatedAt @map("fecha_modificacion")

  proveedor   Usuario     @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  categoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  solicitudes Solicitud[]
  reportes    Reporte[]

  @@index([estado, fechaPublicacion])
  @@index([categoriaId])
  @@index([proveedorId])
  @@map("servicios")
}

// ---------------------------------------------------------------------
// SOLICITUDES (RF-09 a RF-11, RF-15)
// ---------------------------------------------------------------------
model Solicitud {
  id                  String          @id @default(cuid()) @map("id_solicitud")
  clienteId           String          @map("id_cliente")
  servicioId          String          @map("id_servicio")
  estado              EstadoSolicitud @default(PENDIENTE)
  modalidad           Modalidad?
  mensajeInicial      String?         @map("mensaje_inicial") @db.VarChar(1000)
  precioAcordado      Decimal         @map("precio_acordado") @db.Decimal(10, 2)
  metodoPago          MetodoPago?     @map("metodo_pago")
  notaPago            String?         @map("nota_pago") @db.VarChar(200)
  fechaSolicitud      DateTime        @default(now()) @map("fecha_solicitud")
  fechaUltimoCambio   DateTime        @default(now()) @map("fecha_ultimo_cambio")
  fechaPagoConfirmado DateTime?       @map("fecha_pago_confirmado")
  fechaEntrega        DateTime?       @map("fecha_entrega")
  fechaFinalizacion   DateTime?       @map("fecha_finalizacion")

  cliente  Usuario   @relation("ClienteSolicitudes", fields: [clienteId], references: [id], onDelete: Restrict)
  servicio Servicio  @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  mensajes Mensaje[]
  resena   Resena?

  @@index([clienteId])
  @@index([servicioId])
  @@map("solicitudes")
}

// ---------------------------------------------------------------------
// MENSAJES del chat de la solicitud (RF-16, RN-12)
// Los adjuntos se guardan en la base de datos (bytea) para que solo se
// descarguen a través de una ruta que verifica permisos.
// ---------------------------------------------------------------------
model Mensaje {
  id             String   @id @default(cuid()) @map("id_mensaje")
  solicitudId    String   @map("id_solicitud")
  remitenteId    String   @map("id_remitente")
  contenido      String?  @db.Text
  archivoNombre  String?  @map("archivo_nombre") @db.VarChar(150)
  archivoTipo    String?  @map("archivo_tipo") @db.VarChar(100)
  archivoTamano  Int?     @map("archivo_tamano")
  archivoDatos   Bytes?   @map("archivo_datos")
  fechaEnvio     DateTime @default(now()) @map("fecha_envio")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  remitente Usuario   @relation(fields: [remitenteId], references: [id], onDelete: Restrict)

  @@index([solicitudId, fechaEnvio])
  @@map("mensajes")
}

// ---------------------------------------------------------------------
// RESEÑAS / CALIFICACIONES (RF-12 a RF-14, RN-09: una por solicitud)
// ---------------------------------------------------------------------
model Resena {
  id           String   @id @default(cuid()) @map("id_resena")
  solicitudId  String   @unique @map("id_solicitud")
  calificacion Int      @db.SmallInt
  comentario   String?  @db.VarChar(500)
  fechaResena  DateTime @default(now()) @map("fecha_resena")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)

  @@map("resenas")
}

// ---------------------------------------------------------------------
// SEGURIDAD: sesiones en servidor, intentos de acceso, bitácora
// ---------------------------------------------------------------------
model Sesion {
  id          String   @id @default(cuid())
  tokenHash   String   @unique @map("token_hash") @db.VarChar(64) // SHA-256 del token; el token real solo vive en la cookie
  usuarioId   String   @map("id_usuario")
  creada      DateTime @default(now())
  ultimoUso   DateTime @default(now()) @map("ultimo_uso")
  expira      DateTime
  userAgent   String?  @map("user_agent") @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

model IntentoAcceso {
  id      String   @id @default(cuid())
  clave   String   @db.VarChar(200) // correo o IP normalizados
  exitoso Boolean
  fecha   DateTime @default(now())

  @@index([clave, fecha])
  @@map("intentos_acceso")
}

model Bitacora {
  id        String   @id @default(cuid())
  usuarioId String?  @map("id_usuario")
  accion    String   @db.VarChar(60)
  detalle   String?  @db.VarChar(500)
  fecha     DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@map("bitacora")
}

// ---------------------------------------------------------------------
// MODERACIÓN (RN-11 integridad académica, evolución 2.6 de la SRS)
// ---------------------------------------------------------------------
model Reporte {
  id          String        @id @default(cuid())
  servicioId  String        @map("id_servicio")
  reportanteId String       @map("id_reportante")
  motivo      String        @db.VarChar(500)
  estado      EstadoReporte @default(ABIERTO)
  fecha       DateTime      @default(now())

  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  reportante Usuario  @relation("ReportesCreados", fields: [reportanteId], references: [id], onDelete: Restrict)

  @@unique([servicioId, reportanteId])
  @@map("reportes")
}
